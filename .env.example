# ---- Client-safe (shipped in the browser bundle via Vite) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Server-only — NEVER expose to the browser ----
# Supabase Dashboard → Settings → API Keys → secret key
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ---- Admin seed script only ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_NAME=Your Name

# ---- Integrations (server-only, set in Vercel → Project → Environment Variables) ----
# Public URL of this dashboard — used to build OAuth redirect URLs
APP_URL=https://your-dashboard.vercel.app

# LinkedIn — https://www.linkedin.com/developers/apps → Auth tab.
# Add "<APP_URL>/api/integrations/linkedin/callback" as an authorised redirect URL
# and request the "Community Management API" product for page analytics.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional overrides
# LINKEDIN_REDIRECT_URI=https://your-dashboard.vercel.app/api/integrations/linkedin/callback
# LINKEDIN_API_VERSION=202508

# Protects the daily sync cron (/api/cron/sync-integrations). Any long random string.
CRON_SECRET=

# Google Analytics 4 needs NO env vars: each site's GA4 property id and a
# service-account JSON are entered in the dashboard (Settings → Google Analytics).
# The site's NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID (G-XXXX) is recorded there too.
